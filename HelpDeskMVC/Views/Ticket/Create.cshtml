@model HelpDeskMVC.Models.Ticket

@{
    ViewData["Title"] = "Create Support Ticket";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-1">Create Support Ticket</h4>
                    <small>Fill in the details below to raise a new support request.</small>
                </div>

                <div class="card-body">

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Message
                        </div>
                    }

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Enter ticket title"
                                   required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the issue"
                                      required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">

                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold"></label>
                                <select asp-for="Priority" class="form-select" required>
                                    <option value="">Choose Priority</option>
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <input asp-for="Status"
                                       class="form-control bg-light"
                                       value="Open"
                                       readonly />
                            </div>

                        </div>

                        <div class="mb-4">
                            <label asp-for="RaisedBy" class="form-label fw-semibold"></label>
                            <input asp-for="RaisedBy"
                                   class="form-control"
                                   placeholder="Enter your name"
                                   required />
                            <span asp-validation-for="RaisedBy" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back
                            </a>

                            <button type="submit" class="btn btn-success">
                                Create Ticket
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}